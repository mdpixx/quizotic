# Server
PORT=4000
NODE_ENV=development

# Public origin, used to build absolute links that leave the app — QR/join
# URLs and, critically, the one-click unsubscribe link in lifecycle email.
# A relative URL is useless in an inbox, so this must be the real origin in
# production.
NEXT_PUBLIC_APP_URL=http://localhost:4000

# Database (Neon PostgreSQL or Railway PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/quizotic

# Redis (optional but recommended in prod — Railway Redis plugin)
# Enables: (1) Socket.io cross-instance broadcast, and (2) live-session
# durability — sessions are mirrored to Redis and rehydrated on boot, so a
# redeploy/crash no longer ends games in progress ("Game not found"). Unset =
# single-instance, in-memory only (fine for local dev).
REDIS_URL=                 # redis://default:password@host:6379

# Auth (NextAuth v5)
AUTH_SECRET=               # Generate: openssl rand -base64 32
NEXTAUTH_SECRET=           # Same as AUTH_SECRET (used by socket auth)
NEXTAUTH_URL=http://localhost:4000
GOOGLE_CLIENT_ID=          # Google Cloud Console > OAuth 2.0 credentials
GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID (corporate O365 users — bypasses email-gateway magic-link blocks)
# Register at https://entra.microsoft.com > App registrations, any MS account type.
# Redirect URI: {NEXTAUTH_URL}/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# Payments — Razorpay (primary)
RAZORPAY_KEY_ID=           # Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=   # Razorpay Dashboard > Settings > Webhooks
RAZORPAY_PLAN_MONTHLY=plan_xxx   # Subscription plan ID for monthly
RAZORPAY_PLAN_YEARLY=plan_xxx    # Subscription plan ID for yearly

# Email — two channels, two senders, two reputations.
#
# Transactional (magic links, receipts, session invites) goes out over the
# Gmail API from the Google Workspace mailbox. Lifecycle mail (onboarding
# nudges, digests, testimonial asks) goes out over Resend from the
# mail.quizotic.live subdomain. The split is deliberate: a spam complaint on
# a nudge must never be able to degrade magic-link deliverability, because
# magic links ARE the login.
EMAIL_FROM=Quizotic <info@quizotic.live>            # transactional sender (Gmail API)
GMAIL_API_CLIENT_ID=       # Google Cloud Console > OAuth 2.0 credentials
GMAIL_API_CLIENT_SECRET=
GMAIL_API_REFRESH_TOKEN=   # OAuth2 refresh token for the info@ mailbox

RESEND_API_KEY=            # Resend > API keys — scope to mail.quizotic.live, sending access only
EMAIL_FROM_LIFECYCLE=Quizotic <hello@mail.quizotic.live>   # lifecycle sender (Resend)
EMAIL_REPLY_TO=info@quizotic.live                   # replies to nudges land in the human inbox

# Lifecycle automation rollout controls. See docs/lifecycle-automation-spec.md §10.
#
# LIFECYCLE_DRY_RUN defaults to TRUE when unset or empty, and only an explicit
# "false" (or "0") turns it off. That default is deliberate: live-by-default
# would turn a config mistake into a mass email instead of a log line. Watch a
# full week of logged intent before changing it.
#
# LIFECYCLE_TEST_EMAILS restricts real sends to a comma-separated allowlist.
# Empty means "no restriction", NOT "block everyone" — the kill-switch feature
# flag (lifecycle_emails_enabled) is what stops sends, not this.
LIFECYCLE_DRY_RUN=true
LIFECYCLE_TEST_EMAILS=     # e.g. you@example.com,pilot@example.com

# Global send ceilings. Every other guard is per-user and bounds what one
# person receives; these bound what the whole system emits, so a backlog that
# builds up while the system is dark cannot go out as one bulk send.
# Unset means the defaults below. An explicit 0 pauses sending without
# touching the kill-switch flag. Nothing is dropped when a cap binds — the
# nudges stay pending and the next hourly tick picks them up.
LIFECYCLE_DAILY_CAP=80     # rolling 24h, across all users. Resend's plan allows 100/day
LIFECYCLE_TICK_CAP=20      # per hourly run, so the allowance spreads across the day

# Bearer token for POST /api/internal/lifecycle/tick, which the Railway cron
# service hits hourly. Generate: openssl rand -base64 32
# Unset means the endpoint answers 503 and refuses to run — an endpoint that
# can send email must not default to open because a variable was forgotten.
CRON_SECRET=

# Admin (comma-separated emails that can grant/revoke Pro)
ADMIN_EMAILS=

# PostHog Analytics (EU region)
NEXT_PUBLIC_POSTHOG_KEY=    # PostHog > Settings > Project API Key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Google Analytics 4 (Measurement ID from analytics.google.com > Admin > Data Streams)
NEXT_PUBLIC_GA4_ID=          # G-XXXXXXXXXX

# Search-engine site verification (set after creating the GSC / Bing properties)
NEXT_PUBLIC_GSC_VERIFICATION=    # Search Console > Settings > Ownership > HTML tag (content value)
NEXT_PUBLIC_BING_VERIFICATION=   # Bing Webmaster Tools meta-tag content value

# Cloudflare R2 (Image Storage for quiz questions)
R2_ACCOUNT_ID=              # Cloudflare Dashboard > R2 > bucket settings > S3 API
R2_ACCESS_KEY_ID=           # R2 API Tokens > Create API Token
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=quizotic-uploads
R2_PUBLIC_URL=              # R2 bucket > Public Development URL (https://pub-xxx.r2.dev)

# AI Generation (OpenRouter)
OPENROUTER_API_KEY=
QUIZ_AI_MODEL=google/gemini-2.5-flash-preview-05-20
